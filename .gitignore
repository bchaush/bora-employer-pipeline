# OS / editor noise
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
coverage/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json

# Local data / exports
tmp/
temp/
exports/
downloads/

# Logs generated at runtime
logs/*.log

# CAREER_OS_BOUNDED_AGENT_BUILD_LOOP_V1: local, per-machine milestone-run
# state (manifests, locks, builder/reviewer/assurance artifacts). Never
# committed -- restart-safety comes from this being reconstructible from
# Git plus these local files, never from repository history.
.career-os/

# Sensitive local files
*.csv
*.xlsx
*.xls
*.pdf
*.docx

# Keep repository documentation files explicitly tracked
!BLUEPRINT.md
!AGENTS.md
!GEMINI.md
!CURRENT_STATE.md
!CHANGELOG.md