{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bora-employer-pipeline.local/schemas/production_ledger_mutation.schema.json",
  "title": "Supervised Production V1 Ledger Mutation Plan",
  "description": "Deterministic JOBS + LOG mutation plan produced by production_ledger.py. Contains no provider credentials, account IDs, label IDs, or spreadsheet IDs. Provider writes are applied by the supervised connector layer from this plan, not embedded here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobs_mutations", "log_mutations"],
  "properties": {
    "jobs_mutations": {
      "type": "array",
      "items": { "$ref": "#/$defs/jobs_mutation" }
    },
    "log_mutations": {
      "type": "array",
      "items": { "$ref": "#/$defs/log_mutation" }
    }
  },
  "$defs": {
    "pipeline_state": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "NORMALIZED",
        "VERIFICATION_REQUIRED",
        "PROCESSING_ERROR",
        "UPSTREAM_REJECTED",
        "REVIEW_READY"
      ]
    },
    "gate_state": {
      "type": "string",
      "enum": ["PASS", "HOLD", "REJECT", "NOT_EVALUATED"],
      "description": "SUPERVISED_PRODUCTION_V1_SLICE_2: bounded control-plane projection of an already-established upstream gate outcome. Never a new truth enum; never rewrites Employer Truth, Candidate Truth, Match Truth, or existing job enums."
    },
    "match_state": {
      "type": "string",
      "enum": ["NOT_REACHED", "ANALYZED", "PROCESSING_ERROR"],
      "description": "SUPERVISED_PRODUCTION_V1_SLICE_2: whether the existing Match Truth core (analyze_job) was reached and completed. Never a fit score."
    },
    "role_status_state": {
      "type": ["string", "null"],
      "enum": [
        "VERIFIED_LIVE",
        "LIKELY_LIVE",
        "UNCLEAR",
        "POSSIBLY_STALE",
        "CONFIRMED_CLOSED",
        null
      ],
      "description": "SUPERVISED_PRODUCTION_V1_SLICE_2: existing canonical role_status (schemas/job.schema.json) passed through verbatim, never reinterpreted."
    },
    "decision_state": {
      "type": ["string", "null"],
      "enum": [
        "PRIORITY_APPLY",
        "APPLY",
        "EFFICIENT_APPLY",
        "WATCH",
        "REJECT",
        "UNDECIDED",
        null
      ],
      "description": "SUPERVISED_PRODUCTION_V1_SLICE_2: existing analyze_job() decision passed through verbatim, never reinterpreted. Projection only -- never a Bora_Decision/pursuit record."
    },
    "jobs_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Op",
        "Job_ID",
        "Company",
        "Role",
        "Discovery_Source",
        "Discovery_URL",
        "Official_URL",
        "First_Seen",
        "Last_Verified",
        "Pipeline_State"
      ],
      "properties": {
        "Op": { "type": "string", "enum": ["CREATE", "UPDATE"] },
        "Job_ID": { "type": "string", "minLength": 1 },
        "Company": { "type": ["string", "null"] },
        "Role": { "type": ["string", "null"] },
        "Discovery_Source": { "type": "string", "enum": ["GMAIL"] },
        "Discovery_URL": { "type": ["string", "null"], "format": "job-url" },
        "Official_URL": { "type": ["string", "null"], "format": "job-url" },
        "First_Seen": { "type": "string", "format": "date-time" },
        "Last_Verified": { "type": "string", "format": "date-time" },
        "Pipeline_State": { "$ref": "#/$defs/pipeline_state" },
        "Freshness_State": { "$ref": "#/$defs/gate_state" },
        "Geography_State": { "$ref": "#/$defs/gate_state" },
        "OPT_Screen_State": { "$ref": "#/$defs/gate_state" },
        "Candidate_Condition_State": { "$ref": "#/$defs/gate_state" },
        "Threshold_State": { "$ref": "#/$defs/gate_state" },
        "Role_Status": { "$ref": "#/$defs/role_status_state" },
        "Match_State": { "$ref": "#/$defs/match_state" },
        "Decision": { "$ref": "#/$defs/decision_state" }
      }
    },
    "log_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Run_ID",
        "Timestamp",
        "Stage",
        "Source",
        "Job_ID",
        "Status",
        "Error_Code",
        "Engine_Baseline",
        "Notes"
      ],
      "properties": {
        "Run_ID": { "type": "string", "minLength": 1 },
        "Timestamp": { "type": "string", "format": "date-time" },
        "Stage": {
          "type": "string",
          "enum": [
            "INGESTION",
            "IDENTITY_RESOLUTION",
            "FIRST_PARTY_IDENTITY_RESOLUTION",
            "LEDGER_PERSISTENCE",
            "GATE_MATCH_PROJECTION"
          ]
        },
        "Source": { "type": "string", "enum": ["GMAIL", "FIRST_PARTY_VERIFICATION", "SUPERVISED_ANALYSIS"] },
        "Job_ID": { "type": ["string", "null"] },
        "Status": { "$ref": "#/$defs/pipeline_state" },
        "Error_Code": { "type": ["string", "null"] },
        "Engine_Baseline": { "type": "string", "minLength": 1 },
        "Notes": { "type": "string" }
      }
    }
  }
}
