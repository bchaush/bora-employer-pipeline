{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bora-employer-pipeline.local/schemas/gold_resume_model.schema.json",
  "title": "Career OS Gold Resume Model",
  "description": "Approved structured resume model consumed by the deterministic Gold DOCX builder (PURSUE_TO_GOLD_PACKAGE_V1). It carries presentation content and claim lineage only; identity facts (contact, education, titles, employers, dates, links) are verified value-for-value against approved records by Gold QA. It is not Candidate Truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "job_id",
    "contact",
    "summary",
    "education",
    "skills",
    "work",
    "project"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "location",
        "email"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "profile_links": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^(https|http|mailto):[^\\s]+$"
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "claim_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 900
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "school",
          "date_range",
          "degree_line"
        ],
        "properties": {
          "school": {
            "type": "string",
            "minLength": 1
          },
          "date_range": {
            "type": "string",
            "minLength": 1
          },
          "degree_line": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "items",
          "claim_ids"
        ],
        "properties": {
          "label": {
            "enum": [
              "Process & quality",
              "Technical",
              "Operations"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "work": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experience_id",
          "title",
          "employer",
          "date_range",
          "bullets"
        ],
        "properties": {
          "experience_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "employer": {
            "type": "string",
            "minLength": 1
          },
          "date_range": {
            "type": "string",
            "minLength": 1
          },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "claim_ids"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "claim_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experience_id",
        "name",
        "tech_label",
        "link",
        "bullets"
      ],
      "properties": {
        "experience_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tech_label": {
          "type": "string",
          "minLength": 1
        },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "url"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^(https|http|mailto):[^\\s]+$"
            }
          }
        },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "claim_ids"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "claim_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "roster_omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roster_entry",
          "reason"
        ],
        "properties": {
          "roster_entry": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "enum": [
              "TRUTH_APPROVAL_REQUIRED",
              "NOT_RELEVANT_PER_CROSSWALK"
            ]
          }
        }
      }
    },
    "crosswalk_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bulmarma_requirement_ids"
      ],
      "properties": {
        "bulmarma_requirement_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
