{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bora-employer-pipeline.local/schemas/job_analysis_golden_case.schema.json",
  "title": "Job Analysis Golden Case Expected Behavior",
  "description": "Structured expected behavior for one Job Analysis v1 Golden fixture. Encodes Blueprint-aligned expectations, not arbitrary current implementation drift.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "purpose",
    "role_family",
    "acceptable_decisions",
    "key_matches",
    "semantic_boundaries",
    "known_limitations"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^GT_[A-Z0-9_]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "role_family": {
      "type": ["string", "null"]
    },
    "acceptable_decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "PRIORITY_APPLY",
          "APPLY",
          "EFFICIENT_APPLY",
          "WATCH",
          "REJECT",
          "UNDECIDED"
        ]
      },
      "description": "Narrow expected decision set. Broad catch-all lists are rejected."
    },
    "forbidden_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "PRIORITY_APPLY",
          "APPLY",
          "EFFICIENT_APPLY",
          "WATCH",
          "REJECT",
          "UNDECIDED"
        ]
      },
      "default": []
    },
    "key_matches": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result"],
        "properties": {
          "result": {
            "type": "string",
            "enum": ["STRONG", "SUPPORTED", "PARTIAL", "NONE", "UNKNOWN"]
          },
          "require_provenance": {
            "type": "boolean",
            "default": false
          },
          "acceptable_results": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["STRONG", "SUPPORTED", "PARTIAL", "NONE", "UNKNOWN"]
            }
          }
        }
      }
    },
    "expect_gap_substrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "expect_unknown_substrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "require_hard_blockers": {
      "type": "boolean",
      "default": false
    },
    "expected_importance": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["MANDATORY", "PREFERRED", "UNCLEAR"]
      },
      "default": {}
    },
    "semantic_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["P-1", "P-2", "NONE"]
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    }
  }
}
