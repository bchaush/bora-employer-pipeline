{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bora-employer-pipeline.local/schemas/job_analysis_result.schema.json",
  "title": "Bora Employer Pipeline Job Analysis Result",
  "description": "First vertical-slice structured output of analyze_job: requirements, evidence matches, gaps/unknowns, and inspectable lane/decision. Not a résumé patch and not a hire-probability score.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "company",
    "role",
    "role_family",
    "seniority",
    "requirements",
    "evidence_matches",
    "gaps",
    "unknowns",
    "lane",
    "decision",
    "warnings",
    "extraction_mode"
  ],
  "properties": {
    "job_id": { "type": "string", "minLength": 1 },
    "company": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "role_family": { "type": ["string", "null"] },
    "seniority": { "type": ["string", "null"] },
    "requirements": {
      "type": "array",
      "items": { "type": "object" }
    },
    "evidence_matches": {
      "type": "array",
      "items": { "type": "object" }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "lane": {
      "type": "string",
      "enum": [
        "LANE_0_REJECT",
        "LANE_1_EFFICIENT_APPLY",
        "LANE_2_PRIORITY_APPLY",
        "WATCH",
        "UNASSIGNED"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "PRIORITY_APPLY",
        "APPLY",
        "EFFICIENT_APPLY",
        "WATCH",
        "REJECT",
        "UNDECIDED"
      ]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "extraction_mode": {
      "type": "string",
      "enum": [
        "STRUCTURED_EXTRACTION_PROVIDED",
        "EXTRACTION_REQUIRED"
      ],
      "description": "V1 requires a structured extraction payload. This milestone does not call paid model APIs."
    },
    "decision_rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
