{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bora-employer-pipeline.local/schemas/milestone_run.schema.json",
  "title": "Career OS Milestone Run Manifest",
  "description": "CAREER_OS_BOUNDED_AGENT_BUILD_LOOP_V1. Durable, locally-persisted (never committed -- see .gitignore's .career-os/ entry) run manifest for one bounded milestone execution. Historical run facts are persisted here; CURRENT repository/Git/GitHub reality is always independently recomputed on every run/resume, never trusted from this file alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "milestone_id",
    "contract_path",
    "contract_sha256",
    "execution_policy_sha256",
    "authorized_baseline_sha",
    "origin_main_observed_sha",
    "working_branch",
    "worktree_path",
    "phase",
    "implementation_attempt_count",
    "repair_attempt_count",
    "review_attempt_count",
    "review_correction_count",
    "infrastructure_retry_count",
    "stop_reason",
    "human_approval_state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "milestone_id": { "type": "string", "minLength": 1 },
    "contract_path": { "type": "string", "minLength": 1 },
    "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "execution_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorized_baseline_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "origin_main_observed_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "working_branch": { "type": "string", "minLength": 1 },
    "worktree_path": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "enum": [
        "INITIALIZING",
        "BUILDING",
        "TESTING",
        "REPAIRING",
        "REVIEWING",
        "CORRECTING_REVIEW",
        "ASSURING",
        "READY_FOR_HUMAN_APPROVAL",
        "HUMAN_REVIEW_REQUIRED",
        "ARCHITECTURE_DECISION_REQUIRED",
        "ABORTED"
      ]
    },
    "implementation_attempt_count": { "type": "integer", "minimum": 0 },
    "repair_attempt_count": { "type": "integer", "minimum": 0 },
    "review_attempt_count": { "type": "integer", "minimum": 0 },
    "review_correction_count": { "type": "integer", "minimum": 0 },
    "infrastructure_retry_count": { "type": "integer", "minimum": 0 },
    "builder_session_id": { "type": ["string", "null"] },
    "reviewer_session_id": { "type": ["string", "null"] },
    "diff_fingerprint": { "type": ["string", "null"] },
    "last_test_artifact": { "type": ["string", "null"] },
    "last_valid_test_artifact": { "type": ["string", "null"] },
    "last_valid_test_diff_fingerprint": { "type": ["string", "null"] },
    "last_reviewer_artifact": { "type": ["string", "null"] },
    "last_reviewer_diff_fingerprint": { "type": ["string", "null"] },
    "assurance_artifact": { "type": ["string", "null"] },
    "stop_reason": { "type": ["string", "null"] },
    "human_approval_state": {
      "type": "string",
      "enum": ["NOT_REQUESTED", "PENDING", "APPROVED", "REJECTED"]
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  }
}
