{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bora-employer-pipeline.local/schemas/resume_master.schema.json",
  "title": "Bora Employer Pipeline Protected Master Résumé",
  "description": "Protected master résumé data layer. Derivatives must not mutate this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "master_id",
    "version",
    "protected",
    "contact",
    "modules",
    "experience_sections",
    "default_module_order",
    "skills_order",
    "date"
  ],
  "properties": {
    "master_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "protected": {
      "type": "boolean",
      "const": true,
      "description": "Master layer is always protected from generation mutation."
    },
    "contact": {
      "$ref": "resume_immutable_contact.schema.json"
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["education_id", "school_name", "degree_name"],
        "properties": {
          "education_id": { "type": "string", "minLength": 1 },
          "school_name": { "type": "string", "minLength": 1 },
          "degree_name": { "type": "string", "minLength": 1 },
          "date_range": { "type": ["string", "null"] },
          "location": { "type": ["string", "null"] }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "resume_module.schema.json"
      }
    },
    "experience_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "experience_id",
          "organization",
          "formal_title",
          "date_range",
          "bullet_module_ids"
        ],
        "properties": {
          "section_id": { "type": "string", "minLength": 1 },
          "experience_id": { "type": "string", "minLength": 1 },
          "organization": { "type": "string", "minLength": 1 },
          "formal_title": { "type": "string", "minLength": 1 },
          "employment_category": { "type": ["string", "null"] },
          "date_range": { "type": "string", "minLength": 1 },
          "location": { "type": ["string", "null"] },
          "bullet_module_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "summary_module_id": {
      "type": ["string", "null"]
    },
    "default_module_order": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Top-level module ordering for default master view."
    },
    "skills_order": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
