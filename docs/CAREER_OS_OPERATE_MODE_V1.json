{
  "spec": "CAREER_OS_OPERATE_MODE_V1",
  "run_contract": {
    "contract_id": "CAREER_OS_RUN_CONTRACT_V1_4",
    "cli": "src/career_os_run_v1.py",
    "runbook": "docs/CAREER_OS_OPERATE_MODE_V1.md",
    "state_machine": [
      "readback",
      "preflight",
      "slate",
      "STOP_FOR_BORA_DECISION",
      "decide",
      "package",
      "CONNECTOR_UPLOADS_EXACTLY_3",
      "CONNECTOR_DOWNLOADS_READBACK",
      "verify-persisted",
      "HUMAN_VISUAL_AND_CLAIM_REVIEW",
      "BORA_MANUAL_SUBMIT",
      "record-submit",
      "closeout"
    ],
    "step_done_rule": "A step is done only when its receipt exists.",
    "final_reply_rule": "Every run's final reply ends with the closeout block.",
    "closeout_final_lines": [
      "CAREER_OS_RUN_CLOSEOUT: COMPLETE",
      "CAREER_OS_RUN_CLOSEOUT: INCOMPLETE"
    ],
    "cloud_render_profile": "CHATGPT_CLOUD_OPERATIONAL_RENDER_V1",
    "persist_file_count": 3,
    "upload_conversion": "FORBIDDEN",
    "ledger_dedupe_keys": [
      "Job_ID",
      "Official_URL"
    ],
    "package_ledger_identity_keys": [
      "Job_ID",
      "Company",
      "Role",
      "Official_URL"
    ],
    "live_settings_keys": [
      "CANONICAL_MAIN_SHA",
      "RUNTIME_BUNDLE_SHA256",
      "CLOUD_ADAPTER_SHA256",
      "OPERATE_MODE_CONFIG_SHA256",
      "OPERATE_MODE_RUNBOOK_SHA256",
      "GOVERNED_FONTS_SHA256",
      "CLOUD_RENDER_PROFILE"
    ],
    "submission_authority": "BORA_ONLY",
    "auto_submit": false,
    "cover_letter_runtime": false,
    "readback_rule": "ledger.json is built only by the readback command from the whole Ledger: --xlsx with the Google Drive .xlsx export (preferred; the CLI parses it, text cells only), or --raw with the Google Sheets read-values call; never hand-built, retyped or partly read; bare-number cells are refused; run readback again after every Ledger write.",
    "decision_command": "decide (pursuit_decision.build_decision_mutation_plan from the canonical ledger.json)",
    "slate_dates": "slate --as-of stamps First_Seen and Last_Verified",
    "external_submission_command": "record-external-submit (Bora-confirmed; Resume_Version EXTERNAL_NO_CAREER_OS_PACKAGE, never a hash)",
    "screening_states_rule": "OPT_Screen_State, Geography_State and the system Decision inform Bora; after Bora's PURSUE they never block package."
  },
  "network_contract": {
    "contract_id": "CAREER_OS_NETWORK_V1",
    "cli": "src/career_os_network_v1.py",
    "commands": [
      "network-add",
      "network-update",
      "network-draft",
      "record-outcome",
      "weekly-report"
    ],
    "network_headers": [
      "Contact_ID",
      "Name",
      "Company",
      "Role_Title",
      "How_Found",
      "Relationship",
      "Purpose",
      "Linked_Job_ID",
      "Status",
      "Added_On",
      "Last_Touch",
      "Next_Action_Date",
      "Notes"
    ],
    "relationships": [
      "BRANDEIS_ALUMNI",
      "FORMER_COLLEAGUE",
      "WINTER_WALK",
      "FACULTY",
      "RECRUITER",
      "OTHER"
    ],
    "purposes": [
      "JOB_REFERRAL",
      "INFO_CHAT",
      "CLIENT_PROSPECT"
    ],
    "statuses": [
      "TO_CONTACT",
      "SENT",
      "REPLIED",
      "CALL_DONE",
      "REFERRED",
      "NO_REPLY",
      "CLOSED"
    ],
    "follow_up_days": {
      "SENT": 7,
      "REPLIED": 3,
      "CALL_DONE": 7,
      "REFERRED": 14,
      "NO_REPLY": null,
      "CLOSED": null
    },
    "outcome_statuses": [
      "UNDER_REVIEW",
      "INTERVIEW",
      "REJECTED",
      "OFFER",
      "WITHDRAWN",
      "NO_RESPONSE"
    ],
    "draft_max_words": 120,
    "draft_evidence": "APPROVED_BULLET_WITH_NETWORKING_ALLOWED_CLAIMS_ONLY",
    "sends_messages": false,
    "linkedin_automation": false,
    "touches_jobs": false,
    "scores": false
  }
}
